FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy shared modules
COPY shared/ /app/shared/

# Set Python path
ENV PYTHONPATH=/app

# Default command (overridden by service-specific Dockerfiles)
CMD ["python", "main.py"]
