#!/bin/bash

geoips run single_source {{ file_path }} \
    --reader_name georing_netcdf \
    --product_name {{ product_name }} \
    --output_formatter {{ output_type }} \
    --filename_formatter geoips_fname \
    --filename_formatter_kwargs '{"basedir": "/home/erose/geoips/geoips_packages/outdirs/preprocessed/{{ outdir_type }}/"}' \
    --resampled_read \
    --sector_list {{ sector }} \
    --no_presectoring \
    --logging_level info \
    --minimum_coverage 0
retval=$?

exit $retval
