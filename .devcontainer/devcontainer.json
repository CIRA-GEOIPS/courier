// For format details, see https://aka.ms/devcontainer.json.
// For config options, see the devcontainers
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "courier Devcontainer",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bullseye",
	"postCreateCommand": "pip install -e .[doc,lint,test] && pluginify create",
	"mounts": [
		"source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached"
	],
	"containerEnv": {"PLUGINIFY_REBUILD_REGISTRIES": "1", "PLUGINIFY_NAMESPACE": "runcourier.dev.plugin_packages"},
	"runArgs": [
		"--network=courier_testing"
	],
	"initializeCommand": "docker network create courier_testing 2>/dev/null || true",
	"customizations": {
		"vscode": {
			"extensions": [
				"lextudio.restructuredtext",
				"ms-python.python",
				"ms-python.vscode-pylance",
				"charliermarsh.ruff",
				"matangover.mypy",
				"tamasfe.even-better-toml",
				"streetsidesoftware.code-spell-checker",
				"ms-azuretools.vscode-docker",
				"njpwerner.autodocstring",
				"esbenp.prettier-vscode",
				"ms-vscode.live-server",
				"ms-python.black-formatter",
				"ms-python.flake8",
				"trond-snekvik.simple-rst"
			],
			"settings": {
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
				"python.linting.enabled": true,
				"python.linting.mypyEnabled": true,
				"editor.formatOnSave": true,
				"editor.codeActionsOnSave": {
					"source.fixAll.ruff": "always"
				},
				"python.testing.pytestEnabled": true,
				"[python]": {
					"editor.defaultFormatter": "charliermarsh.ruff"
				},
				"ruff.enable": true,
				"ruff.format.enable": true,
				"ruff.organizeImports": false // Ruff format will handle imports
			}
		}
	},
	"remoteUser": "vscode"
}
